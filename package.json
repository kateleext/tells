{
  "name": "tells",
  "private": true,
  "type": "module",
  "scripts": {
    "probe": "node --env-file-if-exists=.env test/probe.js",
    "replay": "node --env-file-if-exists=.env test/replay.js",
    "money": "node --env-file-if-exists=.env test/money.js",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "package": "node build.mjs && rm -f tells-extension.zip && cd extension && zip -qr ../tells-extension.zip manifest.json options.html dist"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "linkedom": "^0.18.13",
    "playwright-core": "^1.55.0"
  }
}
